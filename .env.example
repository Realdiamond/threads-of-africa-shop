# Copy to .env for local development. .env is gitignored — never commit real secrets.

# Postgres connection string. On Railway, reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgres://toa:toa_dev_password@127.0.0.1:5432/toa_dev

# Used only by the integration tests (a separate, disposable database).
TEST_DATABASE_URL=postgres://toa:toa_dev_password@127.0.0.1:5432/toa_test

# The shop's public address, used in links inside emails and in Stripe's return links.
# SITE_URL=https://thethreadsofafrica.com

# Stripe — leave unset until the client provides the account. Checkout stays closed without BOTH.
# STRIPE_SECRET_KEY=sk_test_...
# In Stripe: Developers → Webhooks → add https://<your domain>/api/stripe/webhook and enable
# checkout.session.completed, checkout.session.expired, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed and charge.refunded. Paste the signing secret here.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Try the whole purchase without Stripe: "paying" happens on a clearly-labelled test page.
# Ignored in production unless ALLOW_MOCK_PAYMENTS=true is also set — never do that on the live site.
# PAYMENTS_PROVIDER=mock

# Emails (receipts, shipping updates, contact form). EMAIL_PROVIDER=console just prints them.
# RESEND_API_KEY=
# EMAIL_FROM="The Threads of Africa <orders@thethreadsofafrica.com>"
# EMAIL_PROVIDER=console
